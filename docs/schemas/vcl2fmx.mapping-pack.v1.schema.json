{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vcl2fmx.mapping-pack.v1",
  "title": "VCL2FMXConverter Mapping Pack v1",
  "type": "object",
  "required": [
    "schema",
    "pack_name",
    "pack_id",
    "vendor",
    "version",
    "description",
    "mode",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "vcl2fmx.mapping-pack.v1"
    },
    "pack_name": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "conservative",
        "detection"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "mappingRow": {
      "type": "object",
      "required": [
        "vcl",
        "fmx"
      ],
      "properties": {
        "vcl": {
          "type": "string",
          "minLength": 1
        },
        "fmx": {
          "type": "string",
          "minLength": 1
        },
        "needs_transform": {
          "type": "boolean"
        },
        "transformer": {
          "type": "string"
        },
        "signature_match": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "required": [
        "vcl_class",
        "action",
        "confidence"
      ],
      "properties": {
        "vcl_class": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "fmx_class": {
          "type": "string"
        },
        "action": {
          "enum": [
            "convert",
            "partial",
            "manual_review",
            "detect_only",
            "preserve"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "notes": {
          "type": "string"
        },
        "manual_review_reason": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingRow"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingRow"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
